// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: ALU.hdl
CHIP ALU {
    IN x[16], y[16], zx, nx, zy, ny, f, no;
    OUT out[16], zr, ng;
    PARTS:
    Mux16(a=x, b=false, sel=zx, out=x1);
    Not16(in=x1, out=notx1);
    Mux16(a=x1, b=notx1, sel=nx, out=x2);
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=noty1);
    Mux16(a=y1, b=noty1, sel=ny, out=y2);
    Add16(a=x2, b=y2, out=sum);
    And16(a=x2, b=y2, out=andxy);
    Mux16(a=andxy, b=sum, sel=f, out=o);
    Not16(in=o, out=noto);
    Mux16(a=o, b=noto, sel=no, out=out, out[15]=ng, out[0..7]=low, out[8..15]=high);
    Or8Way(in=low, out=orLow);
    Or8Way(in=high, out=orHigh);
    Or(a=orLow, b=orHigh, out=nonZero);
    Not(in=nonZero, out=zr);
}
