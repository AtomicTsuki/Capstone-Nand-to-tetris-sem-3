// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: PC.hdl
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    PARTS:
    Inc16(in=prev, out=incremented);
    Mux16(a=prev, b=incremented, sel=inc, out=m1);
    Mux16(a=m1, b=in, sel=load, out=m2);
    Mux16(a=m2, b=false, sel=reset, out=m3);
    Or(a=load, b=inc, out=l1);
    Or(a=l1, b=reset, out=anyChange);
    Register(in=m3, load=anyChange, out=prev, out=out);
}
